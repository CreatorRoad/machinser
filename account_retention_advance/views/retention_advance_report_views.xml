<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retention_advance_report_wizard_form" model="ir.ui.view">
        <field name="name">retention.advance.report.wizard.form</field>
        <field name="model">retention.advance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Retention and Advance Report">
                <sheet>
                    <group>
                        <group>
                            <field name="date_to"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="project_sale_order_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook invisible="not line_ids">
                        <page string="Report Summary" name="summary_page">
                            <field name="line_ids">
                                <list create="false" delete="false">
                                    <field name="partner_id"/>
                                    <field name="project_sale_order_id"/>
                                    <field name="total_invoiced_untaxed" sum="Total Untaxed Invoiced"/>
                                    <field name="total_invoiced" sum="Total Invoiced"/>
                                    <field name="retention_held" sum="Total Retention Held"/>
                                    <field name="retention_released" sum="Total Retention Released"/>
                                    <field name="retention_balance" sum="Total Retention Balance" class="fw-bold"/>
                                    <field name="advance_received" sum="Total Advance Received"/>
                                    <field name="advance_recovered" sum="Total Advance Recovered"/>
                                    <field name="advance_balance" sum="Total Advance Balance" class="fw-bold"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_export_excel"
                            string="Export to Excel"
                            type="object"
                            class="btn-primary"
                            icon="fa-file-excel-o"/>
                    <button name="action_view_report"
                            string="View"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_retention_advance_report_wizard" model="ir.actions.act_window">
        <field name="name">Retention &amp; Advance Report</field>
        <field name="res_model">retention.advance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_retention_advance_report"
              name="Retention &amp; Advance Report"
              parent="account.menu_finance_reports"
              action="action_retention_advance_report_wizard"
              sequence="30"/>
</odoo>
