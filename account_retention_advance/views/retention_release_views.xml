<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retention_release_wizard_form" model="ir.ui.view">
        <field name="name">retention.release.wizard.form</field>
        <field name="model">retention.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Release Customer Retention">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="project_sale_order_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <field name="line_ids">
                        <list editable="bottom" create="false" delete="true">
                            <field name="invoice_id" readonly="1" force_save="1"/>
                            <field name="invoice_date" readonly="1"/>
                            <field name="project_sale_order_id" readonly="1"/>
                            <field name="retention_held" readonly="1"/>
                            <field name="retention_already_released" readonly="1"/>
                            <field name="retention_balance" readonly="1"/>
                            <field name="amount_to_release" sum="Total Release"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total_amount_to_release" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_release_retention"
                            string="Release Retention"
                            type="object"
                            class="oe_highlight"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_retention_release_wizard" model="ir.actions.act_window">
        <field name="name">Release Retention</field>
        <field name="res_model">retention.release.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
    </record>

    <menuitem id="menu_action_retention_release"
              name="Release Retention"
              parent="account.menu_finance_receivables"
              action="action_retention_release_wizard"
              sequence="25"/>
</odoo>
