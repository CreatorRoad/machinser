<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_retention_advance" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.retention.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_order_id"
                       invisible="partner_type != 'customer'"
                       readonly="state != 'draft'"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="advance_remaining_amount"
                       invisible="partner_type != 'customer' or state not in ('in_process', 'paid')"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_inherit_retention_advance" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.retention.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_order_id" optional="show"/>
                <field name="advance_remaining_amount" optional="show" sum="Total Remaining Advance"/>
            </xpath>
        </field>
    </record>
</odoo>
